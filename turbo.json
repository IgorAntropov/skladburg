{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "env": ["BUILD_PROFILE"],
      "outputs": ["dist/**"]
    },
    "deps:proto": {
      "inputs": ["package.json", "buf.yaml"],
      "outputs": ["proto-deps/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^generate"],
      "env": ["BUILD_PROFILE"],
      "persistent": true
    },
    "generate": {
      "dependsOn": ["deps:proto"],
      "inputs": ["proto/**", "buf.yaml", "buf.gen.yaml", "package.json"],
      "outputs": ["src/gen/**"]
    },
    "lint:fsd": {
      "outputs": []
    },
    "lint:proto": {
      "dependsOn": ["deps:proto"],
      "inputs": ["proto/**", "buf.yaml"],
      "outputs": []
    },
    "preview": {
      "cache": false,
      "dependsOn": ["build"],
      "env": ["BUILD_PROFILE"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["generate", "^generate"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate", "^generate"],
      "outputs": []
    }
  }
}
