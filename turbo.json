{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["BUILD_PROFILE"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "env": ["BUILD_PROFILE"],
      "persistent": true
    },
    "lint:fsd": {
      "outputs": []
    },
    "preview": {
      "cache": false,
      "dependsOn": ["build"],
      "env": ["BUILD_PROFILE"],
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
