{
  "name": "skladburg",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e",
  "scripts": {
    "postinstall": "pnpm proto:generate",
    "prepare": "simple-git-hooks",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "test": "vitest run && turbo run test",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "lint": "tsc -p tsconfig.json && turbo run typecheck lint:fsd lint:proto && eslint --max-warnings 0 --no-error-on-unmatched-pattern apps packages scripts \"*.ts\" && node scripts/check-comments.ts",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern apps packages scripts \"*.ts\" && pnpm --filter @skladburg/contracts format:proto",
    "proto:generate": "turbo run generate --filter=@skladburg/contracts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "~24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm test"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": "eslint --max-warnings 0 --no-warn-ignored --fix",
    "{*.{css,scss,html,svg,yml,yaml,proto,json},.gitignore,.nvmrc,.npmrc,.env*}": "node scripts/check-comments.ts"
  }
}
